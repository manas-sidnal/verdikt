# Environment variables — copy to .env and fill in real values
# DO NOT commit your actual .env file

NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional: allow a hosted frontend to call the API (comma-separated origins)
# VERDIKT_CORS_ORIGINS=https://your-frontend.example.com
# Optional: protect credits on a public demo
# VERDIKT_LIVE_LIMIT_PER_HOUR=30
# VERDIKT_MAX_CONCURRENT_RUNS=2
